POSTGRES_DB=sales_tool
POSTGRES_USER=sales_tool
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_AN_ADMIN_PASSWORD
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
COOKIE_SECURE=false
WEB_PORT=8089
TASK_WORKERS=2
MAX_UPLOAD_BYTES=536870912
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

# 留空时使用 Docker 自带 PostgreSQL；使用宝塔 PostgreSQL 时取消注释并修改：
# DATABASE_URL=postgresql+psycopg://用户名:密码@host.docker.internal:5432/数据库名
