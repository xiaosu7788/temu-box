POSTGRES_DB=temubox
POSTGRES_USER=temubox
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_AN_ADMIN_PASSWORD
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
COOKIE_SECURE=false
WEB_PORT=8089
TASK_WORKERS=2
# 自动清理的检查间隔（秒，默认 6 小时；保留天数在后台"系统设置"中配置）
CLEANUP_INTERVAL_SECONDS=21600
MAX_UPLOAD_BYTES=536870912
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

# 留空时使用 Docker 内置 PostgreSQL；使用外部 PostgreSQL 时取消注释并修改：
# DATABASE_URL=postgresql+psycopg://temubox:数据库密码@host.docker.internal:5432/temubox

# 后台「一键热更新」（可选）：执行 ./scripts/enable-updater.sh 会自动生成并写入下面几项，
# 一般不需要手工填写。UPDATER_TOKEN 留空表示不启用该功能，详见 DEPLOYMENT.md 第 7 节方式 C。
# UPDATER_TOKEN=
# TEMUBOX_PROJECT_DIR=/var/www/temu-box
# UPDATER_BRANCH=main

# 记住密码（可选）：base64 编码的 32 字节密钥，用于加密存库的 Temu 密码。
#   openssl rand -base64 32
# 留空时该功能自动关闭；更换密钥会让已保存的密码全部失效，需要用户重新勾选。
# CREDENTIAL_KEY=

# 店铺管理模块（可选）：设置 BRIDGE_TOKEN 后启用 bridge 容器
#   docker compose --profile stores up -d bridge
# 不设置时模块接口返回 503「店铺管理服务未配置」，其余功能不受影响。
# BRIDGE_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN
# STORE_BRIDGE_URL=http://bridge:8898
# BRIDGE_LOGIN_MIN_INTERVAL_MS=3000
# BRIDGE_LOGIN_WINDOW_MAX=5
