# 换行符统一：避免 Windows 上编辑后把 CRLF 带进仓库
# bash 脚本带 \r 会直接 syntax error（历史踩过）

* text=auto

*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf

*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制/大文件不参与换行转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.gif       binary
*.ico       binary
*.xlsx      binary
*.zip       binary
*.gz        binary
*.tgz       binary
